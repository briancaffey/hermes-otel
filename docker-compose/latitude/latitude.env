# Environment for docker-compose/latitude/docker-compose.yaml (upstream's .env.production).
# Values follow the "for production" hints in upstream's .env.example, with
# service hostnames instead of localhost. Local-only secrets: regenerate
# LAT_MASTER_ENCRYPTION_KEY and LAT_BETTER_AUTH_SECRET (openssl rand -hex 32)
# and change the passwords before exposing this to anyone else.

POSTGRES_USER=latitude
POSTGRES_PASSWORD=secret
POSTGRES_DB=latitude
POSTGRES_RUNTIME_USER=latitude_app
POSTGRES_RUNTIME_PASSWORD=secret
CLICKHOUSE_USER=latitude
CLICKHOUSE_PASSWORD=secret
CLICKHOUSE_DB=latitude
NODE_ENV=production
LAT_IMAGE_TAG=latest

LAT_CLICKHOUSE_URL=http://clickhouse:8123
LAT_CLICKHOUSE_USER=latitude
LAT_CLICKHOUSE_PASSWORD=secret
LAT_CLICKHOUSE_DB=latitude
LAT_CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
LAT_CLICKHOUSE_CLUSTER_ENABLED=false

LAT_DATABASE_URL=postgres://latitude_app:secret@postgres:5432/latitude
LAT_ADMIN_DATABASE_URL=postgres://latitude:secret@postgres:5432/latitude

LAT_REDIS_HOST=redis
LAT_REDIS_PORT=6379
LAT_BULLMQ_HOST=redis-bullmq
LAT_BULLMQ_PORT=6379

LAT_TEMPORAL_ADDRESS=temporal:7233
LAT_TEMPORAL_NAMESPACE=default
LAT_TEMPORAL_TASK_QUEUE=latitude-workflows

LAT_STORAGE_DRIVER=s3
LAT_STORAGE_S3_BUCKET=latitude
LAT_STORAGE_S3_REGION=eu-central-1
LAT_STORAGE_S3_ACCESS_KEY_ID=latitude
LAT_STORAGE_S3_SECRET_ACCESS_KEY=secret
LAT_STORAGE_S3_ENDPOINT=http://seaweedfs:8333
LAT_STORAGE_S3_FORCE_PATH_STYLE=true

LAT_WEB_URL=http://localhost:3000
LAT_WEB_PORT=3000
LAT_API_URL=http://localhost:3001
LAT_API_PORT=3001
LAT_INGEST_URL=http://localhost:3002
LAT_INGEST_PORT=3002
LAT_TRUSTED_ORIGINS=http://localhost:3000
LAT_CORS_ALLOWED_ORIGINS=http://localhost:3000

LAT_REDACTION_PSEUDONYM_SECRET=9189fb5f23a3dc47d1e829ffb5ce278dc8a26358a0cca83c9cd63ce25bfd9b83
LAT_MASTER_ENCRYPTION_KEY=75d697b90c1e46c13bd7f7343ab2b9a9e430cdcda05d47f055e1523d54d5409b
LAT_BETTER_AUTH_SECRET=bd84f86b2cc1011da17d68e5a808f873d30383bc3717c4e770629e4f3b55b7da

# Sign-in is by magic link; the bundled Mailpit catches the mail at
# http://localhost:8025 so no real email transport is needed.
LAT_MAILPIT_HOST=mailpit
LAT_MAILPIT_PORT=1025
LAT_MAILPIT_FROM=noreply@latitude.local

LAT_AWS_REGION=eu-central-1
LAT_BILLING_ENABLED=false
