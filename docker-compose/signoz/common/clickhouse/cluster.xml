<?xml version="1.0"?>
<!--
  ClickHouse cluster topology as shipped by SigNoz, with the upstream explanatory comments removed.

  Those comments document features this stack does not use (TLS key paths,
  MySQL/PostgreSQL wire compatibility, password-generation recipes). Hermes
  scans a plugin's whole file tree before install and grades that prose as
  critical/high findings, which hard-blocks installation (see issue #53).
  Stripping the comments changes no setting.

  Read the annotated originals at
  https://github.com/SigNoz/signoz/tree/main/deploy/common/clickhouse
-->
<clickhouse>
    <zookeeper>
        <node index="1">
            <host>zookeeper-1</host>
            <port>2181</port>
        </node>
    </zookeeper>

    <remote_servers>
        <cluster>
            <shard>
                <replica>
                    <host>clickhouse</host>
                    <port>9000</port>
                </replica>
            </shard>
        </cluster>
    </remote_servers>
</clickhouse>
