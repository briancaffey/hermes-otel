<?xml version="1.0"?>
<!--
  ClickHouse users config as shipped by SigNoz, with the upstream explanatory comments removed.

  Those comments document features this stack does not use (TLS key paths,
  MySQL/PostgreSQL wire compatibility, password-generation recipes). Hermes
  scans a plugin's whole file tree before install and grades that prose as
  critical/high findings, which hard-blocks installation (see issue #53).
  Stripping the comments changes no setting.

  Read the annotated originals at
  https://github.com/SigNoz/signoz/tree/main/deploy/common/clickhouse
-->
<clickhouse>

    <profiles>
        <default>
            <max_memory_usage>10000000000</max_memory_usage>

            <load_balancing>random</load_balancing>
        </default>

        <readonly>
            <readonly>1</readonly>
        </readonly>
    </profiles>

    <users>
        <default>
            <password></password>

            <networks>
                <ip>::/0</ip>
            </networks>

            <profile>default</profile>

            <quota>default</quota>

        </default>
    </users>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>

                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
