# hermes-otel plugin configuration
# ==============================================================================
#
# Copy this file to $HERMES_HOME/hermes_otel.yaml (i.e. ~/.hermes/hermes_otel.yaml)
# and edit to taste:
#
#   cp config.yaml.example ~/.hermes/hermes_otel.yaml
#
# Keep it OUTSIDE the plugin directory. Upgrading means reinstalling, which
# replaces ~/.hermes/plugins/hermes_otel/ wholesale — a config kept in there
# is deleted. The legacy in-plugin path still works; $HERMES_OTEL_CONFIG
# overrides both.
#
# Everything here is optional — the plugin ships with sensible defaults and
# will fall back to environment-variable-driven single-backend detection when
# no config.yaml is present.
#
# Precedence per field:
#   env var (HERMES_OTEL_*)  >  config.yaml  >  built-in default
#
# Secrets should live in env vars, not in this file. Use the `*_env:` keys on
# each backend entry to point at the env var name.

# ── Project / resource attributes ─────────────────────────────────────────────

# Shows up in the Phoenix "Project" dropdown and as `openinference.project.name`
# on every span. Also settable via OTEL_PROJECT_NAME / HERMES_OTEL_PROJECT_NAME.
# project_name: hermes-agent

# Fleets: report each named profile as its own service, so service pickers and
# service maps show `coder`, `reviewer`... instead of one `hermes-agent`.
# Sets service.name=<profile> and service.namespace=hermes-agent; the default
# profile stays service.name=hermes-agent. resource_attributes.service.name
# still wins. Also settable via HERMES_OTEL_SERVICE_NAME_FROM_PROFILE.
# service_name_from_profile: false

# Free-form key/value pairs merged into the OTel Resource of every span.
# Good for deployment tags (env, region, team).
# resource_attributes:
#   deployment: prod
#   region: us-east-1
#   team: platform

# global_tags is a deprecated alias: merged into resource_attributes at load, with a warning.
# global_tags:
#   team: platform

# Extra HTTP headers added to every OTLP exporter call across ALL backends.
# Per-backend headers (under `backends:` below) are merged on top and win on conflict.
# headers:
#   X-Company-Auth: shared-secret
#
# Headers that expire (a Google Cloud access token, a vault-issued OIDC token, a
# rotated key) come from a per-backend `headers_helper:` instead: a command (an
# argv string, no shell) whose stdout — a JSON object or `Name=value` lines — is
# merged over the entry's static headers on every signal. On a 401/403 the plugin
# re-runs it once and retries that batch once (#483). The helper runs with the
# plugin's environment. See website/docs/configuration/short-lived-credentials.md.
# backends:
#   - type: otlp
#     endpoint: https://telemetry.googleapis.com/v1/traces
#     headers_helper: /home/me/.hermes/mint-gcp-headers.sh   # prints Authorization=Bearer ...
#     headers_helper_timeout_ms: 5000                          # default

# ── Telemetry shaping ─────────────────────────────────────────────────────────

# Master kill switch. Set to false to disable the plugin without uninstalling.
# enabled: true

# Sampling ratio (0.0 - 1.0). Leave unset or null for AlwaysOn (100%).
# Set e.g. 0.1 to sample 10% of traces; ParentBased sampler preserves trace
# consistency — if the root span is sampled, its descendants are too.
# sample_rate: null

# Preview truncation cap applied to tool input/output, user_message, and
# assistant_response. Keep reasonable — huge previews bloat every span.
# preview_max_chars: 1200

# Per-category overrides for the cap above (null = use preview_max_chars).
# Also settable via HERMES_OTEL_TOOL_INPUT_PREVIEW_MAX_CHARS, etc.
# tool_input_preview_max_chars: null
# tool_output_preview_max_chars: null
# llm_input_preview_max_chars: null
# llm_output_preview_max_chars: null

# What of the conversation content is recorded on spans:
#   full     the complete prompt (system prompt + every message) and the
#            complete response on every api.* span, unclipped; previews on the
#            other spans. The default: this is a debugging tool and the data
#            goes only to the backends you configure. Large: every api.* span
#            in a turn carries the whole prefix.
#   preview  clipped previews only (preview_max_chars and the caps above).
#   off      no prompt, tool or response content at all; metadata only.
# Quote the value: a bare `off` is YAML for false (accepted, means off).
# Also settable via HERMES_OTEL_CONTENT_CAPTURE.
# content_capture: "full"

# Pre-1.11 spellings, still honoured and kept consistent with content_capture:
# capture_previews: false is `off`; capture_full_prompts / capture_full_responses
# true is `full` (set one of them false to keep that side as previews).
# capture_previews: true
# capture_full_prompts: true
# capture_full_responses: true


# Platform sender ID capture. When true, gateway sessions add the raw
# platform sender ID as hermes.sender.id and a backend-neutral user.id
# formatted as "{platform}:{sender_id}". The platform is already emitted
# on LLM spans as llm.provider.
# This can identify users (for example Discord, Telegram, Slack, email, SMS),
# so keep it opt-in. CLI sessions usually leave it empty.
# capture_sender_id: false

# Put the entire conversation_history the model is about to see on the
# llm.* span's input.value. The api.* spans don't carry message-level
# detail, so flipping this on is the easiest way to see what the model saw.
# Output is JSON (input.mime_type=application/json) — Phoenix pretty-prints it.
# Respects `capture_previews` above.
# capture_conversation_history: false

# Max serialized size for the conversation history (JSON, UTF-8 bytes ~ chars).
# Clipped with a trailing "..." if the conversation is bigger.
# conversation_history_max_chars: 20000

# ── Logs ─────────────────────────────────────────────────────────────────────
#
# Opt-in: forward Python `logging` records to every log-capable backend
# (SigNoz, Loki via LGTM, OpenObserve, Uptrace, Parseable, Honeycomb, any
# OTLP collector) and to the dashboard's Logs tab. One processor runs ahead
# of every sink: it stamps the trace/span ids of the turn the line belongs to
# (exactly, never by guessing), adds the session attributes, drops Hermes'
# host-internal record attributes and redacts secrets with Hermes' own
# redactor. See https://briancaffey.github.io/hermes-otel/configuration/logs
#
# Off by default because attaching to the root logger is invasive: it exports
# logs from every library hermes-agent imports, not just the plugin.
#
# The `logs:` block is the preferred spelling. Every key below also exists as
# a flat field (capture_logs, log_level, log_attach_logger, log_exclude_loggers,
# log_logger_levels, log_only_in_turn, log_max_attribute_length,
# log_batch_schedule_delay_ms, log_batch_max_queue_size,
# log_batch_max_export_batch_size, log_batch_export_timeout_ms,
# log_live_min_level, log_events, log_events_content) and as
# HERMES_OTEL_<FIELD> environment variables; the flat spellings keep working.
#
# logs:
#   capture: false                 # the switch (= capture_logs)
#   level: INFO                    # handler level: DEBUG, INFO, WARN, ERROR
#   attach_logger: null            # null = root logger; "agent", "gateway", "tools",
#                                  # "hermes_cli", "hermes_otel" or any logger name to scope
#   # Logger-name prefixes never forwarded. Default = the OTel SDK and the HTTP
#   # client stack (loop guard) plus the third-party loggers Hermes pins at WARNING.
#   exclude_loggers: [opentelemetry, urllib3, httpx, httpcore, requests, openai,
#                     asyncio, hpack, grpc, websockets, charset_normalizer, markdown_it]
#   logger_levels: {gateway.config: WARNING}   # per-logger floors
#   only_in_turn: false            # drop lines the plugin cannot attribute to a session
#   max_attribute_length: 4096     # longest exported string attribute
#   live_min_level: INFO           # floor for the dashboard's live Logs tab
#   batch:                         # BatchLogRecordProcessor knobs
#     schedule_delay_ms: 1000
#     max_queue_size: 2048
#     max_export_batch_size: 512
#     export_timeout_ms: 30000
#   events:                        # structured hermes.* / GenAI events (off by default)
#     enabled: false
#     content: inherit             # inherit (follow content_capture) | full | preview | off
#
# Per backend, `logs:` on an entry may be `true` / `false` (the signal switch)
# or a mapping with the same `level`, `exclude_loggers`, `logger_levels`,
# `only_in_turn` and `events` keys, which turns the signal on and narrows the
# global settings for that backend only (stricter only; a weaker value warns
# and is ignored):
#
# backends:
#   - type: openobserve
#     endpoint: http://localhost:5080/api/default/v1/traces
#     logs: {level: WARN, events: {content: off}}

# ── OTel GenAI semantic-convention metrics ────────────────────────────────────
#
# In addition to the custom hermes.* metrics, the plugin emits spec-named
# instruments so generic OpenTelemetry GenAI dashboards/alerts light up with
# no per-user wiring:
#   gen_ai.client.token.usage      Histogram {token}  (gen_ai.token.type input/output)
#   gen_ai.client.operation.duration  Histogram s     (SECONDS, per spec)
#   gen_ai.agent.token.usage       Histogram {token}  (per-turn/session rollup)
# Dimensions stay low-cardinality (operation, provider, model — never per-call
# IDs). Set false to emit only the hermes.* metrics.
# Also settable via HERMES_OTEL_EMIT_GENAI_METRICS.
# emit_genai_metrics: true
#
# Metric temporality for OTLP export (#233). Unset = the SDK default
# (cumulative, or OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE). Set
# `delta` for Datadog, New Relic and Logfire style backends; a backend entry's
# own `metrics_temporality:` wins, and signoz / uptrace entries default to delta.
# metrics_temporality: cumulative
#
# Histogram aggregation: `explicit` (spec bucket boundaries) or `exponential`
# (base-2 exponential histograms; Prometheus native histograms, Datadog,
# New Relic, Uptrace).
# metrics_histogram: explicit
#
# Distinct values a label such as `model` or `tool_name` may take per process
# before the rest fold into `other` (the Python SDK has no cardinality limit).
# metrics_label_limit: 100
#
# Claude Code metric-name compatibility (#485). `claude_code` exports the
# session count, token usage, cost and active time under Claude Code's names,
# units and labels (claude_code.session.count, claude_code.token.usage,
# claude_code.cost.usage, claude_code.active_time.total) instead of their
# hermes.* twins, so a Grafana dashboard built for Claude Code shows Hermes
# as one more agent; `both` keeps the hermes.* twins too. Claude Code's
# dashboards count sessions by `session.id`; opt in to that label below.
# metric_name_compat: off
# metric_name_compat_session_id: false

# ── Skill execution-window spans ──────────────────────────────────────────────
#
# When the agent successfully loads a skill — via the skill_view tool or a read
# of a file under /skills/ — the plugin opens a skill.<name> span that runs from
# the end of the loading tool call until the turn boundary, nested under the
# turn's agent span. <name> is always the bare skill name Hermes uses
# (``skills/<category>/<name>/SKILL.md`` → ``<name>``). Failed loads get no
# skill span and are not listed in hermes.turn.skills. Skills overlap freely
# (two loaded in one turn → two concurrent spans). Attributes:
# hermes.skill.name, hermes.skill.source (skill_view|path_match),
# hermes.skill.path, hermes.skill.result_status, hermes.span_kind=skill.
# The hermes.skill.* attribute and skill_inferred counter are unaffected.
# Set false to keep only those and skip the spans.
# Also settable via HERMES_OTEL_SKILL_SPANS.
# skill_spans: true

# ── Join an outer trace (#474) ────────────────────────────────────────────────
#
# Whatever launches Hermes (a CI job, a script, another agent) can export
# HERMES_OTEL_TRACEPARENT (a W3C traceparent) and optionally
# HERMES_OTEL_TRACESTATE; every turn root of the process is then a child of
# that span, marked hermes.trace.remote_parent=true. Set false to ignore the
# variables. The kanban worker hand-off (plain TRACEPARENT) is separate.
# Also settable via HERMES_OTEL_REMOTE_PARENT.
# remote_parent: true

# ── Reachability probe (#481) ─────────────────────────────────────────────────
#
# At init the plugin opens one TCP connection to each backend endpoint on a
# background thread and logs "reachable" or "unreachable" per backend, so a
# backend that is down is said so at startup instead of 30 s later inside the
# export worker. Once, never periodic; no bytes are sent; exports never wait
# for it. Also settable via HERMES_OTEL_PROBE_BACKENDS.
# probe_backends: true

# ── Telemetry discovery prompt (opt-in) ───────────────────────────────────────
#
# Plugin skills do not appear in Hermes' <available_skills> catalog, so by
# default the model does not know hermes_otel:observability exists. Set true to
# register a short system-prompt section (~80 tokens, every session) that tells
# the model telemetry is available and to load that skill for questions about
# past behaviour, tool/skill usage, latency, errors or cost. Off by default
# because it changes what the model sees on every turn.
# Also settable via HERMES_OTEL_DISCOVERY_PROMPT.
# discovery_prompt: false

# ── Live dashboard (local store) ──────────────────────────────────────────────
#
# The built-in dashboard tab has a "Live" mode that renders your agent's recent
# spans + metrics + logs from a small SQLite file the plugin keeps at
# $HERMES_HOME/hermes_otel_live.db (override: HERMES_OTEL_LIVE_DB) — so the
# dashboard works the instant you install the plugin, with NO external backend,
# and the gateway and dashboard processes share it. Each kind (spans, metrics,
# logs) keeps its last dashboard_live_max_spans rows, and rows older than
# dashboard_live_retention_hours are dropped too (0 = only the row cap). It is
# a recent-activity buffer, not a record: configure a backend for history.
# Set dashboard_live: false to disable it entirely (the dashboard then needs a
# configured backend to show anything). Also settable via
# HERMES_OTEL_DASHBOARD_LIVE / HERMES_OTEL_DASHBOARD_LIVE_MAX_SPANS /
# HERMES_OTEL_DASHBOARD_LIVE_RETENTION_HOURS.
# dashboard_live: true
# dashboard_live_max_spans: 1000
# dashboard_live_retention_hours: 168

# ── Host & GPU metrics (opt-in) ───────────────────────────────────────────────
#
# Sample the Hermes process tree's CPU, whole-host CPU, and any AMD/NVIDIA GPU
# on a fixed interval and export the readings through the normal metrics
# pipeline (semantic-convention names, on every backend with metrics on):
#   process.cpu.utilization   Gauge 1   by cpu.mode      (hermes + children)
#   system.cpu.utilization    Gauge 1   by cpu.mode      (whole host)
#   hw.gpu.utilization        Gauge 1   per hw.id        (needs pynvml / amdsmi)
#   hw.gpu.memory.usage       UpDownCounter By per hw.id
#   hw.power                  Gauge W   per hw.id, hw.type=gpu
# Each tool.* span also gets hermes.tool.cpu.utilization.avg/.peak (and
# .gpu. when a GPU is probed) for its execution window. One daemon thread per
# process, nothing on disk. psutil ships with hermes-agent.
# Also settable via HERMES_OTEL_HOST_METRICS / _HOST_METRICS_GPU /
# _HOST_METRICS_INTERVAL_MS.
# host_metrics: false
# host_metrics_gpu: auto          # auto | amd | nvidia | off
# host_metrics_interval_ms: 1000  # 100-250 to cover sub-second tool calls
# ── MCP keepalive pings ───────────────────────────────────────────────────────
#
# The MCP Python SDK 2.x (Hermes v0.21.0+) creates an OTel span for every
# JSON-RPC request it sends — including the `ping` Hermes fires on each idle
# keepalive interval, per MCP connection. Each ping lands as its own one-span
# "MCP send ping" trace, which quickly buries real agent activity. True drops
# the successful pings before they reach any backend or the live dashboard.
# Failed pings (error status) are always kept — they are the useful ones when
# debugging MCP connectivity. Set false to see every ping.
# Also settable via HERMES_OTEL_SUPPRESS_MCP_PING_SPANS.
# suppress_mcp_ping_spans: true

# ── Lifecycle / cleanup ───────────────────────────────────────────────────────

# Orphan-turn sweep TTL. If a session's root span has been open longer than
# this, subsequent hooks finalize it with `hermes.turn.final_status=timed_out`
# so long-abandoned sessions don't stay open forever in the backend UI.
# root_span_ttl_ms: 600000   # 10 minutes

# Delegation-span TTL. A `subagent.*` span stays open across the parent's turns
# (Hermes runs delegations in the background); if its subagent_stop never
# arrives, it is closed after this with `hermes.subagent.swept=true`.
# subagent_span_ttl_ms: 86400000   # 24 hours

# Metrics export interval (how often the PeriodicExportingMetricReader flushes).
# flush_interval_ms: 60000

# Flush every backend's span queue when a turn ends, so the trace shows up in
# the UI right away instead of after span_batch_schedule_delay_ms. Runs on a
# background thread with a 500 ms timeout per backend and coalesces, so a slow
# or unreachable collector never stalls the agent. Metrics and logs export on
# their own schedule; process exit flushes everything.
# force_flush_on_session_end: true
# How long the turn waits for that flush before returning to Hermes, in ms.
# A healthy backend needs far less; a stuck one costs at most this much per
# turn. 0 = do not wait (a one-shot `hermes -z` may then exit before its
# spans are sent).
# force_flush_wait_ms: 1500

# ── BatchSpanProcessor tunables (non-blocking export) ─────────────────────────
# Each backend gets its own processor with these settings. Defaults are fine
# for most workloads; tune only if you're losing spans under heavy load.

# span_batch_max_queue_size: 2048          # spans buffered before drops
# span_batch_schedule_delay_ms: 1000       # worker wake-up cadence
# span_batch_max_export_batch_size: null   # auto: 512, or 64 when content_capture is full
# span_batch_export_timeout_ms: 30000      # per-export HTTP timeout

# ── Multi-backend fan-out ─────────────────────────────────────────────────────
#
# When the `backends:` list below is set and non-empty, the plugin fans out
# every span and metric to each entry in parallel — each backend runs on its
# own BatchSpanProcessor (independent worker thread + queue), so a slow or
# unreachable collector never blocks the agent or starves the others.
#
# [//]: # (generated:backend-types:start)

# Supported `type` values (generated from hermes_otel/backend_specs.py):
#   phoenix      Phoenix — traces; env-var mode: OTEL_PHOENIX_ENDPOINT
#                docs: website/docs/backends/phoenix.md
#   langfuse     Langfuse — traces; env-var mode needs OTEL_LANGFUSE_PUBLIC_API_KEY or OTEL_LANGFUSE_SECRET_API_KEY
#                docs: website/docs/backends/langfuse.md
#   signoz       SigNoz — traces + metrics + logs; env-var mode: OTEL_SIGNOZ_ENDPOINT
#                docs: website/docs/backends/signoz.md
#   jaeger       Jaeger — traces; env-var mode: OTEL_JAEGER_ENDPOINT
#                docs: website/docs/backends/jaeger.md
#   zipkin       Zipkin — traces; env-var mode: OTEL_ZIPKIN_ENDPOINT
#                docs: website/docs/backends/zipkin.md
#   greptime     GreptimeDB — traces + metrics + logs; env-var mode: OTEL_GREPTIME_ENDPOINT
#                docs: website/docs/backends/greptime.md
#   clickstack   ClickStack — traces + metrics + logs; alias `hyperdx`; env-var mode needs OTEL_CLICKSTACK_ENDPOINT
#                docs: website/docs/backends/clickstack.md
#   victoria     Victoria — traces + metrics + logs; alias `victoriatraces`; env-var mode: OTEL_VICTORIA_ENDPOINT
#                docs: website/docs/backends/victoria.md
#   aspire       Aspire Dashboard — traces + metrics + logs; env-var mode: OTEL_ASPIRE_ENDPOINT
#                docs: website/docs/backends/aspire.md
#   gigapipe     Gigapipe — traces + metrics + logs; alias `qryn`; env-var mode: OTEL_GIGAPIPE_ENDPOINT
#                docs: website/docs/backends/gigapipe.md
#   agenta       Agenta — traces; env-var mode needs OTEL_AGENTA_API_KEY or OTEL_AGENTA_ENDPOINT
#                docs: website/docs/backends/agenta.md
#   tempo        Tempo — traces; env-var mode: OTEL_TEMPO_ENDPOINT
#                docs: website/docs/backends/tempo.md
#   uptrace      Uptrace — traces + metrics + logs; env-var mode: OTEL_UPTRACE_ENDPOINT
#                docs: website/docs/backends/uptrace.md
#   openobserve  OpenObserve — traces + metrics + logs; alias `openobserver`; env-var mode: OTEL_OPENOBSERVE_ENDPOINT
#                docs: website/docs/backends/openobserve.md
#   parseable    Parseable — traces + metrics + logs; env-var mode: OTEL_PARSEABLE_ENDPOINT; export only (no dashboard adapter)
#                docs: website/docs/backends/parseable.md
#   honeycomb    Honeycomb — traces + metrics + logs; env-var mode needs OTEL_HONEYCOMB_API_KEY or OTEL_HONEYCOMB_ENDPOINT; export only (no dashboard adapter)
#                docs: website/docs/backends/honeycomb.md
#   elastic      Elastic — traces + metrics + logs; env-var mode needs OTEL_ELASTIC_ENDPOINT; export only (no dashboard adapter)
#                docs: website/docs/backends/elastic.md
#   openlit      OpenLIT — traces + metrics + logs; env-var mode needs OTEL_OPENLIT_ENDPOINT; export only (no dashboard adapter)
#                docs: website/docs/backends/openlit.md
#   mlflow       MLflow — traces; env-var mode needs OTEL_MLFLOW_ENDPOINT; export only (no dashboard adapter)
#                docs: website/docs/backends/mlflow.md
#   opik         Comet Opik — traces; env-var mode needs OTEL_OPIK_API_KEY or OTEL_OPIK_ENDPOINT; export only (no dashboard adapter)
#                docs: website/docs/backends/opik.md
#   laminar      Laminar — traces + logs; env-var mode needs OTEL_LAMINAR_API_KEY or OTEL_LAMINAR_ENDPOINT; export only (no dashboard adapter)
#                docs: website/docs/backends/laminar.md
#   langwatch    LangWatch — traces + metrics + logs; env-var mode needs OTEL_LANGWATCH_API_KEY or OTEL_LANGWATCH_ENDPOINT; export only (no dashboard adapter)
#                docs: website/docs/backends/langwatch.md
#   latitude     Latitude — traces; env-var mode needs OTEL_LATITUDE_API_KEY or OTEL_LATITUDE_ENDPOINT; export only (no dashboard adapter)
#                docs: website/docs/backends/latitude.md
#   weave        W&B Weave — traces; env-var mode needs OTEL_WEAVE_API_KEY or OTEL_WEAVE_ENDPOINT; export only (no dashboard adapter)
#                docs: website/docs/backends/weave.md
#   langsmith    LangSmith — traces; env-var mode needs OTEL_LANGSMITH_API_KEY or OTEL_LANGSMITH_ENDPOINT; export only (no dashboard adapter)
#                docs: website/docs/backends/langsmith.md
#   lgtm         LGTM — traces + metrics + logs; backends: entry only
#                docs: website/docs/backends/lgtm.md
#   otlp         OTLP — traces + metrics + logs; backends: entry only; export only (no dashboard adapter)
#                docs: website/docs/backends/otlp.md

# [//]: # (generated:backend-types:end)
#
# `traces: false`, `metrics: false`, or `logs: false` per entry opt a backend
# out of that signal. This is useful when an entry is dashboard/query-only
# (for example Tempo query URL) while trace export still goes through an OTel
# Collector entry. `trace: false` is accepted as a friendly alias.
#
# `root_usage: false` sends this backend the `agent` / `cron` root without
# its token roll-up (`gen_ai.usage.*` / `llm.token_count.*`); the api.* spans
# and `hermes.cost.*` are untouched and every other backend still gets the
# roll-up. Preset off for `opik` and `langwatch`, which sum usage over every
# span and would show twice the turn's tokens (#327); `true` overrides.
#
# `ui_url:` links the entry's card in the dashboard's Settings tab to the
# backend's web UI (needed where the UI is not on the OTLP origin, e.g.
# Grafana for `lgtm`, Jaeger's :16686, SigNoz's :8080).
#
# When `backends:` is absent or empty, the plugin falls back to single-backend
# env-var detection (OTEL_LANGSMITH_API_KEY, OTEL_LANGFUSE_*, OTEL_SIGNOZ_ENDPOINT,
# OTEL_PARSEABLE_ENDPOINT, OTEL_JAEGER_ENDPOINT, OTEL_TEMPO_ENDPOINT,
# OTEL_PHOENIX_ENDPOINT — first match wins). Setting `backends:` takes full
# control away from env detection.
#
# Example: fan out to all five local collectors (assumes they're running via
# docker-compose/all.sh). Uncomment to use.

# backends:
#   - type: phoenix
#     endpoint: http://localhost:6006/v1/traces
#
#   - type: langfuse
#     # Credentials via env vars (recommended). Plaintext `public_key` /
#     # `secret_key` also accepted but discouraged.
#     public_key_env: LANGFUSE_PUBLIC_KEY
#     secret_key_env: LANGFUSE_SECRET_KEY
#     base_url: https://cloud.langfuse.com
#     # Or override the full OTLP endpoint directly:
#     # endpoint: https://cloud.langfuse.com/api/public/otel/v1/traces
#
#   - type: signoz
#     endpoint: http://localhost:4328/v1/traces
#     # SigNoz Cloud requires an ingestion key; self-hosted ignores the header.
#     ingestion_key_env: OTEL_SIGNOZ_INGESTION_KEY
#     # Dashboard / skill read path (traces, metrics, logs): the UI/API port
#     # and an API key (current SigNoz issues them from a service account).
#     # query_port: 3301
#     # api_key_env: SIGNOZ_API_KEY
#
#   - type: jaeger
#     endpoint: http://localhost:4318/v1/traces
#
#   - type: zipkin
#     endpoint: http://localhost:9411        # ghcr.io/openzipkin-contrib/zipkin-otel
#     # query_port: 9411           # dashboard read path (API v2 + UI, same port)
#
#   - type: clickstack
#     endpoint: http://localhost:4408        # the Collector's OTLP/HTTP (4318 in the container)
#     api_key_env: OTEL_CLICKSTACK_API_KEY   # docker-compose/clickstack/mint-api-key.sh prints it
#     # dashboard read path (ClickHouse over HTTP):
#     # query_port: 8124
#     # user: api
#     # password: api
#     # ui_url: http://localhost:3050
#
#   - type: gigapipe
#     endpoint: http://localhost:3110         # one port: ingest, query APIs and UI
#
#   - type: agenta
#     endpoint: http://localhost:3060         # self-hosted; omit for Agenta Cloud (region: us|eu)
#     api_key_env: OTEL_AGENTA_API_KEY        # docker-compose/agenta/mint-api-key.sh prints one
#
#   - type: aspire
#     endpoint: http://localhost:4418         # OTLP/HTTP (18890 in the container)
#     # query_port: 18888          # dashboard read path (the UI port)
#
#   - type: victoria
#     endpoint: http://localhost:10428          # VictoriaTraces (/insert/opentelemetry/v1/traces)
#     metrics_endpoint: http://localhost:8428   # VictoriaMetrics (/opentelemetry/v1/metrics)
#     logs_endpoint: http://localhost:9428      # VictoriaLogs (/insert/opentelemetry/v1/logs)
#
#   - type: greptime
#     endpoint: http://localhost:4398        # bundled stack (upstream 4000); OTLP under /v1/otlp
#     # db: public                 # X-Greptime-DB-Name on every signal
#     # user_env: OTEL_GREPTIME_USER          # Basic auth, only with a user provider
#     # password_env: OTEL_GREPTIME_PASSWORD
#     # headers: {x-greptime-hints: ttl=7d}   # retention; none by default
#
#   - type: tempo
#     endpoint: http://localhost:3200/v1/traces
#     # query_port: 3200            # dashboard read path (Tempo query API)
#
#   - type: otlp
#     name: my-custom-collector
#     endpoint: http://collector.internal:4318/v1/traces
#     headers:
#       X-Tenant: acme
#     metrics: true
#     logs: true       # override default (on for otlp/signoz/lgtm/uptrace/openobserve/parseable/honeycomb)

# ── LGTM quickstart ──────────────────────────────────────────────────────────
#
# Grafana's "all signals in one container" image (traces + metrics + logs).
# See docker-compose/lgtm/README.md for setup.
#
# backends:
#   - type: lgtm
#     endpoint: http://localhost:4318/v1/traces
#     # Dashboard / skill read path. With the compose stack nothing is needed:
#     # Tempo :3200, Prometheus :9090 and Loki :3100 on the same host are
#     # assumed. Elsewhere, name them (`off` disables a signal):
#     # query_port: 3200
#     # prometheus_url: http://prometheus:9090
#     # metrics_match: '{__name__=~"hermes_.*"}'   # keep a shared Prometheus's list short
#     # loki_url: http://loki:3100
# capture_logs: true
#
# Do NOT use `type: tempo` for the LGTM stack — that's for standalone Tempo
# and would disable the logs/metrics fan-out.

# ── Uptrace quickstart ───────────────────────────────────────────────────────
#
# Uptrace (OSS, ClickHouse + Postgres + Redis) — all three signals.
# See docker-compose/uptrace/README.md for setup.
#
# backends:
#   - type: uptrace
#     endpoint: http://localhost:14318/v1/traces
#     # The ingestion DSN for your Uptrace project. Plugin sends it as the
#     # ``uptrace-dsn`` request header. Prefer env var for anything not
#     # throwaway-local — use `dsn_env:` instead of inline `dsn:`.
#     dsn_env: UPTRACE_DSN
#     # dsn: http://project1_secret@localhost:14318?grpc=14317
#     # Dashboard / skill read path: Uptrace 2's query API wants a USER token
#     # (Settings → API tokens), not the DSN's project token.
#     # user_token_env: UPTRACE_USER_TOKEN
#     # query_port: 14318
#     # project_id: 1
# capture_logs: true

# ── OpenObserve quickstart ───────────────────────────────────────────────────
#
# OpenObserve (OSS, single container) — all three signals, HTTP Basic auth.
# See docker-compose/openobserve/README.md for setup.
#
# backends:
#   - type: openobserve
#     # URL includes the org name. Default org is `default`; swap for your
#     # own under Settings → Organizations in the UI.
#     endpoint: http://localhost:5080/api/default/v1/traces
#     user: root@example.com                  # or user_env: OPENOBSERVE_USER
#     password_env: OPENOBSERVE_PASSWORD
#     # stream_name: default                  # optional; defaults to "default"
# capture_logs: true

# ── Parseable quickstart ─────────────────────────────────────────────────────
#
# Direct OTLP/HTTP export to Parseable. Create the three datasets first; tag
# the traces dataset `agent-observability` to expose it in Parseable Agents.
# Full guide: https://www.parseable.com/docs/ingest-data/ai-agents/hermes
#
# backends:
#   - type: parseable
#     endpoint: https://parseable.example.com/v1/traces
#     api_key_env: PARSEABLE_API_KEY
#     traces_dataset: hermes-traces
#     metrics_dataset: hermes-metrics
#     logs_dataset: hermes-logs
# capture_logs: true

# ── Honeycomb quickstart ─────────────────────────────────────────────────────
#
# Honeycomb (SaaS, OTLP/HTTP) — traces + metrics + logs. See HONEYCOMB.md.
# Trace export also works via a plain `type: otlp` entry; the dedicated
# `honeycomb` type just fills in the endpoint and auth header for you.
#
# backends:
#   - type: honeycomb
#     region: us                              # us (default) or eu
#     api_key_env: HONEYCOMB_API_KEY          # or inline api_key: (discouraged)
#     # Optional dataset (sent as x-honeycomb-dataset). Modern (Environments)
#     # keys IGNORE it — traces route by service.name, metrics to a default
#     # "Metrics" dataset (verified live). Only Honeycomb Classic keys need it
#     # (required for every signal). See HONEYCOMB.md.
#     # dataset: hermes
#     # endpoint:                             # optional; overrides the region default
# capture_logs: true

# ── Elastic quickstart ────────────────────────────────────────────────────────
#
# Elastic ingests OTLP via a managed endpoint (mOTLP) or a self-hosted
# EDOT Collector. Auth uses `Authorization: ApiKey <key>` (NOT Bearer).
# Metrics default to delta temporality (Elastic does not support cumulative
# histograms). See website/docs/backends/elastic.md for the full guide,
# including the bundled docker-compose stack and smoke script.
#
# backends:
#   - type: elastic
#     endpoint: https://<deployment>.ingest.<region>.<csp>.elastic.cloud
#     api_key_env: OTEL_ELASTIC_API_KEY        # Elastic Cloud mOTLP key;
#     #                                          omit for a local EDOT collector
#     # Optional data-stream routing (Resource attributes). The collector
#     # appends ".otel" to the dataset: these two land Hermes data in
#     # traces-hermes_otel.otel-agents / metrics-… / logs-….
#     # dataset: hermes_otel                   # -> data_stream.dataset
#     # namespace: agents                      # -> data_stream.namespace
#     # Self-hosted EDOT Collector instead:
#     # endpoint: http://localhost:4318         # no api_key needed

# ── OpenLIT quickstart ────────────────────────────────────────────────────────
#
# OpenLIT runs an OTLP receiver next to its UI and stores traces, metrics and
# logs. The bundled stack (docker-compose/openlit/) listens on 4338 for
# OTLP/HTTP and 3010 for the UI. No key is needed locally; an OpenLIT API
# key scopes ingest to an organisation/project/environment.
#
# backends:
#   - type: openlit
#     endpoint: http://localhost:4338            # bundled stack; 4318 upstream
#     # api_key_env: OTEL_OPENLIT_API_KEY         # optional; Bearer header
# capture_logs: true

# ── MLflow quickstart ─────────────────────────────────────────────────────────
#
# MLflow 3.6+ ingests OTLP traces on its tracking server and needs the
# x-mlflow-experiment-id header on every request; the plugin sends it from
# `experiment_id`. The bundled stack (docker-compose/mlflow/) listens on 5001.
# Metrics and logs are off (no such routes on the server).
#
# backends:
#   - type: mlflow
#     endpoint: http://localhost:5001
#     # experiment_id: "0"                     # default; the Default experiment
#     # workspace: my-workspace                # optional X-MLFLOW-WORKSPACE
#     # api_key_env: MLFLOW_TRACKING_TOKEN     # optional Bearer token

# ── Comet Opik quickstart ─────────────────────────────────────────────────────
#
# Opik ingests OTLP traces on /api/v1/private/otel/v1/traces; the plugin
# completes the path from the base URL. Self-hosted (docker-compose/opik/)
# needs no auth; Comet cloud needs the API key and workspace.
#
# backends:
#   - type: opik
#     endpoint: http://localhost:5173           # omit for Comet cloud
#     project: hermes-agent                     # optional projectName header
#     # api_key_env: OPIK_API_KEY               # cloud: bare Authorization header
#     # workspace: my-workspace                 # cloud: Comet-Workspace header

# ── Laminar quickstart ────────────────────────────────────────────────────────
#
# Laminar ingests OTLP traces and logs on its app-server; a project API key
# is required and identifies the project. The bundled stack
# (docker-compose/laminar/) publishes the app-server on 8100 and
# docker-compose/laminar/mint-api-key.sh prints a key without the UI.
#
# backends:
#   - type: laminar
#     endpoint: http://localhost:8100           # omit for Laminar cloud
#     api_key_env: LMNR_PROJECT_API_KEY
# capture_logs: true

# ── LangWatch quickstart ──────────────────────────────────────────────────────
#
# LangWatch ingests all three signals under /api/otel; the plugin completes
# the paths from the base URL. The bundled stack (docker-compose/langwatch/)
# listens on 5560 and docker-compose/langwatch/mint-api-key.py creates the
# first project and prints its key.
#
# backends:
#   - type: langwatch
#     endpoint: http://localhost:5560           # omit for LangWatch cloud
#     api_key_env: LANGWATCH_API_KEY            # sk-lw-…
# capture_logs: true

# ── Latitude quickstart ───────────────────────────────────────────────────────
#
# Latitude's ingest service takes OTLP traces with a bearer key and the
# mandatory X-Latitude-Project header; both come from the UI (Settings →
# API keys, and the project slug). The bundled stack
# (docker-compose/latitude/) publishes ingest on 3002. Traces only.
#
# backends:
#   - type: latitude
#     endpoint: http://localhost:3002           # omit for Latitude cloud
#     api_key_env: LATITUDE_API_KEY
#     project: my-project-slug

# ── W&B Weave quickstart ──────────────────────────────────────────────────────
#
# W&B Weave ingests OTLP traces at https://trace.wandb.ai/otel/v1/traces and
# routes them by OTel Resource attributes `wandb.entity` and `wandb.project`.
# It is traces-only by default; keep metrics/logs in LGTM, SigNoz, OpenObserve, etc.
#
# backends:
#   - type: weave
#     api_key_env: WANDB_API_KEY              # or inline api_key: (discouraged)
#     entity: my-team                         # or entity_env: WANDB_ENTITY
#     project: hermes-agent                   # or project_env: WANDB_PROJECT
#     # Dedicated Cloud / Self-Managed:
#     # base_url: https://acme.wandb.io       # plugin appends /traces/otel/v1/traces
#     # endpoint: https://trace.wandb.ai/otel/v1/traces  # optional full override

# ── LangSmith quickstart ──────────────────────────────────────────────────────
#
# LangSmith (SaaS, OTLP/HTTP) — traces only. A regular entry since 1.26
# (#415): it fans out with the rest. The plugin posts to the ingest at
# api.smith.langchain.com/otel/v1/traces with x-api-key and, when a project
# is set, the Langsmith-Project header. In env-var mode
# OTEL_LANGSMITH_API_KEY selects it; LANGSMITH_API_KEY / LANGSMITH_PROJECT /
# LANGSMITH_ENDPOINT are fallback values only. LANGSMITH_TRACING selects nothing.
#
# backends:
#   - type: langsmith
#     api_key_env: LANGSMITH_API_KEY          # or inline api_key: (discouraged)
#     project: hermes-agent                   # optional: or project_env: LANGSMITH_PROJECT
#     # region: eu                            # optional: the EU host
#     # endpoint: https://api.smith.langchain.com   # optional: /otel/v1/traces is appended
