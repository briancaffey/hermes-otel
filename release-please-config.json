{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "hermes-otel",
      "include-v-in-tag": true,
      "extra-files": [
        {
          "type": "yaml",
          "path": "hermes_otel/plugin.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "hermes_otel/dashboard/manifest.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name=='hermes-otel')].version"
        }
      ]
    }
  }
}
